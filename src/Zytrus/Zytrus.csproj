<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- WinRT projections (MediaTranscoder, Windows.Data.Pdf, OCR) come with the Windows TFM. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Zytrus</AssemblyName>
    <RootNamespace>Zytrus</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Zytrus</Product>
    <Company>Zytrus</Company>
    <Description>Zero-Click-Komprimierung für E-Mail-Anhänge</Description>
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>
    <!-- CA1416: WinRT APIs we only call on supported builds. WPF0001: Fluent theme for the settings window. -->
    <NoWarn>$(NoWarn);CA1416;WPF0001</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- PDFsharp: recompresses images inside PDFs and merges PDFs.
         LIZENZ: Bleibt bewusst auf 6.2.4 (MIT). Ab 6.5.0 gilt AGPL oder eine kommerzielle Lizenz –
         NICHT aktualisieren, ohne das vorher zu klären. Exakte Version erzwingen: [6.2.4] -->
    <PackageReference Include="PDFsharp" Version="[6.2.4]" />
  </ItemGroup>

</Project>
