<Window x:Class="Zytrus.UI.CitrusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zytrus" Width="430" Height="430"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        AllowDrop="True" WindowStartupLocation="Manual" UseLayoutRounding="True">
    <Grid x:Name="Host" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="HostScale" ScaleX="1" ScaleY="1" />
                <RotateTransform x:Name="HostRotate" Angle="0" />
            </TransformGroup>
        </Grid.RenderTransform>
    </Grid>
</Window>
