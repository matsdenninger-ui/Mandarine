<Window x:Class="Mandarine.UI.DropZoneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mandarine" Width="330" Height="88"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        AllowDrop="True" Background="Transparent" WindowStartupLocation="Manual"
        FontFamily="{DynamicResource Font.UI}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="0" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="Root" Padding="16,0" Background="{DynamicResource Brush.Surface}">
        <Grid x:Name="Body" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="BodyScale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Width="50" Height="50" CornerRadius="25" Background="{DynamicResource Brush.AccentGradient}">
                <TextBlock x:Name="Glyph" Text="&#xE715;" FontFamily="{DynamicResource Font.Icons}" FontSize="22"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="Für E-Mail komprimieren" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text}" />
                <TextBlock x:Name="HintText" Text="Loslassen · ⇧ + Alt für Optionen" FontSize="12" Margin="0,3,0,0"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
            </StackPanel>

            <Rectangle x:Name="DropOutline" Grid.ColumnSpan="2" Margin="-10,-12" RadiusX="12" RadiusY="12"
                       Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.5" StrokeDashArray="4 3"
                       Fill="{DynamicResource Brush.AccentSoft}" Opacity="0" IsHitTestVisible="False" />
        </Grid>
    </Border>
</Window>
