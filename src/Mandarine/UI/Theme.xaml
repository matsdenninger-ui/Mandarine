<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colors are (re)assigned by Theme.cs for light/dark mode. These are the light defaults. -->
    <SolidColorBrush x:Key="Brush.Surface" Color="#F7F7F8" />
    <SolidColorBrush x:Key="Brush.SurfaceAcrylic" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="Brush.Stroke" Color="#14000000" />
    <SolidColorBrush x:Key="Brush.Text" Color="#1B1B1F" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#5F6368" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#0F000000" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="#1A000000" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF8A1F" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#26FF8A1F" />
    <SolidColorBrush x:Key="Brush.Success" Color="#2EA043" />
    <SolidColorBrush x:Key="Brush.Error" Color="#D93B3B" />

    <LinearGradientBrush x:Key="Brush.AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFB347" Offset="0" />
        <GradientStop Color="#FF7A00" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="Font.UI">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Row in the floating action menu -->
    <Style x:Key="MenuButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Pressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small round icon button (close) -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource MenuButton}">
        <Setter Property="Padding" Value="6" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Icons}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- Text button (Abbrechen, Ordner) -->
    <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource MenuButton}">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- Thin progress bar; pulses while indeterminate -->
    <Style x:Key="ThinProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid ClipToBounds="True">
                        <Border x:Name="PART_Track" CornerRadius="2" Background="{DynamicResource Brush.Hover}" />
                        <Border x:Name="PART_Indicator" CornerRadius="2" Background="{DynamicResource Brush.Accent}" HorizontalAlignment="Left" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="Pulse">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="PART_Indicator" Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0.25" Duration="0:0:0.7" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="Pulse" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
