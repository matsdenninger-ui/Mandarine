<Window x:Class="Mandarine.UI.ActionMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mandarine" Width="300" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="Transparent" WindowStartupLocation="Manual"
        FontFamily="{DynamicResource Font.UI}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="0" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="Root" Padding="6" Background="{DynamicResource Brush.Surface}">
        <StackPanel x:Name="Body">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="BodyShift" Y="0" />
            </StackPanel.RenderTransform>

            <Grid Margin="10,8,10,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="HeaderTitle" Text="3 Dateien" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="HeaderDetail" Text="54,2 MB" FontSize="11" Margin="0,2,0,0"
                               Foreground="{DynamicResource Brush.TextSecondary}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="Esc" FontSize="11" VerticalAlignment="Top"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
            </Grid>

            <Rectangle Height="1" Margin="8,0,8,4" Fill="{DynamicResource Brush.Stroke}" />

            <StackPanel x:Name="Items" />
        </StackPanel>
    </Border>
</Window>
